@@ -3,6 +3,10 @@ package chainfee
 import (
 	"bytes"
 	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
 	"testing"
 	"time"
 
@@ -527,3 +531,38 @@ func TestInvalidFeeUpdateTimeout(t *testing.T) {
 	require.Error(t, err, "NewWebAPIEstimator should return an error "+
 		"when minFeeUpdateTimeout > maxFeeUpdateTimeout")
 }
+
+// TestFeeSourceUsesConfiguredTransport prevents Tor bypass and direct fallback.
+func TestFeeSourceUsesConfiguredTransport(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"fee_by_block_target":{"2":2000},"min_relay_feerate":1000}`))
+	}))
+	defer server.Close()
+	calls := 0
+	source := SparseConfFeeSource{URL: "http://fees.invalid/fees", Dial: func(network, address string) (net.Conn, error) {
+		calls++
+		require.Equal(t, "fees.invalid:80", address)
+		return net.Dial(network, server.Listener.Addr().String())
+	}}
+	_, err := source.GetFeeInfo()
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+	source.URL = server.URL
+	source.Dial = func(network, address string) (net.Conn, error) { return nil, errors.New("Tor offline") }
+	_, err = source.GetFeeInfo()
+	require.ErrorContains(t, err, "Tor offline")
+}
+
+func TestMempoolFeeConversion(t *testing.T) {
+	source := SparseConfFeeSource{}
+	result, err := source.parseResponse(bytes.NewBufferString(`{"fastestFee":1,"halfHourFee":0.5,"hourFee":0.001,"economyFee":0.001,"minimumFee":0.001}`))
+	require.NoError(t, err)
+	require.Equal(t, uint32(1000), result.FeeByBlockTarget[1])
+	require.Equal(t, uint32(500), result.FeeByBlockTarget[3])
+	require.Equal(t, uint32(1), result.FeeByBlockTarget[6])
+	require.Equal(t, SatPerKVByte(1), result.MinRelayFeerate)
+	for _, body := range []string{`{}`, `{"fastestFee":1}`, `{"fastestFee":-1,"halfHourFee":1,"hourFee":1,"economyFee":1,"minimumFee":1}`} {
+		_, err := source.parseResponse(bytes.NewBufferString(body))
+		require.Error(t, err)
+	}
+}
