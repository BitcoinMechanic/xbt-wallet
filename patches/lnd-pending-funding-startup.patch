+// A blocked backend rebroadcast must not hold the entire server below active.
+func TestFundingManagerRestartSlowRebroadcast(t *testing.T) {
+	alice, bob := setupFundingManagers(t)
+	t.Cleanup(func() { tearDownFundingManagers(t, alice, bob) })
+	updates := make(chan *lnrpc.OpenStatusUpdate)
+	_, _ = openChannel(t, alice, bob, 500000, 0, 1, updates, true, nil)
+	release := make(chan struct{})
+	publishing := make(chan struct{}, 1)
+	started := make(chan struct{})
+	go func() {
+		recreateAliceFundingManager(t, alice, func(cfg *Config) {
+			cfg.PublishTransaction = func(tx *wire.MsgTx, label string) error {
+				publishing <- struct{}{}
+				<-release
+				return nil
+			}
+		})
+		close(started)
+	}()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		close(release)
+		<-started
+		t.Fatal("startup waited for the funding transaction rebroadcast")
+	}
+	select {
+	case <-publishing:
+		close(release)
+	case <-time.After(5 * time.Second):
+		close(release)
+		t.Fatal("pending channel was not rebroadcast")
+	}
+}
