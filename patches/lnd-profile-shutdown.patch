+// StopRuntime stops even a locked or uninitialized wallet and reports only
+// after lnd.Main has returned and closed its databases. The Android host uses
+// a fresh process for the next profile; it never relies on global RPC reuse.
+func StopRuntime(callback Callback) {
+	go func() {
+		if atomic.LoadInt32(&lndStarted) == 0 {
+			callback.OnResponse([]byte{})
+			return
+		}
+		interceptor := activeShutdown.Load()
+		if interceptor == nil {
+			callback.OnError(errors.New("node startup has not reached a stoppable state"))
+			return
+		}
+		interceptor.RequestShutdown()
+		deadline := time.After(60 * time.Second)
+		ticker := time.NewTicker(50 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ticker.C:
+				if atomic.LoadInt32(&lndStarted) == 0 {
+					callback.OnResponse([]byte{})
+					return
+				}
+			case <-deadline:
+				callback.OnError(errors.New("node is still shutting down; wallet was not switched"))
+				return
+			}
+		}
+	}()
+}
