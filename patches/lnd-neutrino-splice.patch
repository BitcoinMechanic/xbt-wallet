 }
 
+// ConfirmedOutputWithScript also supports compact-filter backends. The script
+// is a search hint, never evidence: the wallet verifies the creating block and
+// scans for spends before accepting the output.
+func (c *spliceChain) ConfirmedOutputWithScript(op wire.OutPoint, script []byte) (*wire.TxOut, uint32, bool, error) {
+	d, ok := baseWallet(c.wallet).(interface {
+		GetUtxoDetailsWithScript(*wire.OutPoint, []byte, <-chan struct{}) (*wire.TxOut, uint32, bool, error)
+	})
+	if !ok {
+		return c.ConfirmedOutput(op)
+	}
+	cancel := make(chan struct{})
+	defer close(cancel)
+	type answer struct {
+		out      *wire.TxOut
+		confs    uint32
+		coinbase bool
+		err      error
+	}
+	done := make(chan answer, 1)
+	go func() {
+		out, confs, coinbase, err := d.GetUtxoDetailsWithScript(&op, script, cancel)
+		done <- answer{out, confs, coinbase, err}
+	}()
+	select {
+	case a := <-done:
+		return a.out, a.confs, a.coinbase, a.err
+	case <-time.After(confirmedOutputTimeout):
+		return nil, 0, false, fmt.Errorf("backend did not finish verifying confirmation and unspent status of %v within %v; no input accepted", op, confirmedOutputTimeout)
+	}
+}
