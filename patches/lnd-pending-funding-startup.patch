+// rebroadcastFundingTxAsync keeps pending-channel recovery from blocking the
+// server's startup on a slow chain backend. The original transaction is reused;
+// confirmation tracking continues independently and no new funding is created.
+func (f *Manager) rebroadcastFundingTxAsync(c *channeldb.OpenChannel) {
+	f.wg.Add(1)
+	go func() {
+		defer f.wg.Done()
+		select {
+		case <-f.quit:
+			return
+		default:
+		}
+		log.Infof("Rebroadcasting pending channel funding in background: %v", c.FundingOutpoint)
+		f.rebroadcastFundingTx(c)
+		log.Infof("Pending channel funding rebroadcast finished: %v", c.FundingOutpoint)
+	}()
+}
