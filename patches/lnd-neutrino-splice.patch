+func TestNotifiedSpliceConfirmations(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		mined uint32
+		tip   int32
+		reorg bool
+		want  uint32
+	}{
+		{"historical two confirmations", 981721, 981722, false, 2},
+		{"next block", 981721, 981723, false, 3},
+		{"removed transaction", 981721, 981722, true, 0},
+		{"tip behind inclusion", 981721, 981720, false, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			event := &chainntnfs.ConfirmationEvent{Confirmed: make(chan *chainntnfs.TxConfirmation, 1), NegativeConf: make(chan int32, 1)}
+			event.Confirmed <- &chainntnfs.TxConfirmation{BlockHeight: tc.mined}
+			if tc.reorg {
+				event.NegativeConf <- 1
+			}
+			require.Equal(t, tc.want, notifiedSpliceConfirmations(event, nil, func() (int32, error) { return tc.tip, nil }))
+		})
+	}
+	timeout := make(chan time.Time, 1)
+	timeout <- time.Now()
+	require.Zero(t, notifiedSpliceConfirmations(&chainntnfs.ConfirmationEvent{}, timeout, func() (int32, error) { t.Fatal("unconfirmed must not query height"); return 0, nil }))
