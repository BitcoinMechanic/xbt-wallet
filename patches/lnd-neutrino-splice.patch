+package btcwallet
+
+import (
+	"errors"
+	"github.com/btcsuite/btcd/btcutil"
+	"github.com/btcsuite/btcd/btcutil/gcs"
+	"github.com/btcsuite/btcd/btcutil/gcs/builder"
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightninglabs/neutrino"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+type spliceFilterFixture struct {
+	block  *btcutil.Block
+	filter *gcs.Filter
+}
+
+func (f spliceFilterFixture) GetBlockHash(int64) (*chainhash.Hash, error) { return f.block.Hash(), nil }
+func (f spliceFilterFixture) GetCFilter(chainhash.Hash, wire.FilterType, ...neutrino.QueryOption) (*gcs.Filter, error) {
+	return f.filter, nil
+}
+func (f spliceFilterFixture) GetBlock(chainhash.Hash, ...neutrino.QueryOption) (*btcutil.Block, error) {
+	return f.block, nil
+}
+
+func TestNeutrinoSpliceInputVerification(t *testing.T) {
+	for _, name := range []string{"unspent", "spent", "missing", "script mismatch", "wrong value", "coinbase", "reorg", "cancelled", "nil filter"} {
+		t.Run(name, func(t *testing.T) {
+			script := append([]byte{0, 20}, make([]byte, 20)...)
+			tx := wire.NewMsgTx(2)
+			prev := wire.OutPoint{Hash: chainhash.Hash{1}, Index: 0}
+			if name == "coinbase" {
+				prev = wire.OutPoint{Index: 0xffffffff}
+			}
+			tx.AddTxIn(wire.NewTxIn(&prev, nil, nil))
+			tx.AddTxOut(&wire.TxOut{Value: 1000000, PkScript: script})
+			block := btcutil.NewBlock(&wire.MsgBlock{Transactions: []*wire.MsgTx{tx}})
+			filter, err := builder.WithKeyHash(block.Hash()).AddEntry(script).Build()
+			require.NoError(t, err)
+			fixture := spliceFilterFixture{block, filter}
+			if name == "nil filter" {
+				fixture.filter = nil
+			}
+			op := wire.OutPoint{Hash: tx.TxHash(), Index: 0}
+			if name == "missing" {
+				op.Hash = chainhash.Hash{99}
+			}
+			if name == "script mismatch" {
+				tx.TxOut[0].PkScript = []byte{0, 1}
+				op.Hash = tx.TxHash()
+			}
+			cancel := make(chan struct{})
+			if name == "cancelled" {
+				close(cancel)
+			}
+			calls := 0
+			best := func() (*chainhash.Hash, int32, error) {
+				calls++
+				if name == "reorg" && calls > 1 {
+					return &chainhash.Hash{2}, 2, nil
+				}
+				return block.Hash(), 1, nil
+			}
+			scanned := false
+			unspent := func(got *wire.OutPoint, gotScript []byte, h uint32, c <-chan struct{}) (*wire.TxOut, error) {
+				scanned = true
+				require.Equal(t, &op, got)
+				require.Equal(t, script, gotScript)
+				require.EqualValues(t, 1, h)
+				require.Equal(t, (<-chan struct{})(cancel), c)
+				if name == "spent" {
+					return nil, ErrOutputSpent
+				}
+				if name == "wrong value" {
+					return &wire.TxOut{Value: 1, PkScript: script}, nil
+				}
+				return tx.TxOut[0], nil
+			}
+			out, confs, coinbase, err := verifyNeutrinoSpliceOutput(&op, script, cancel, fixture, best, unspent)
+			switch name {
+			case "unspent":
+				require.NoError(t, err)
+				require.EqualValues(t, 1000000, out.Value)
+				require.EqualValues(t, 1, confs)
+				require.False(t, coinbase)
+				require.True(t, scanned)
+			case "coinbase":
+				require.NoError(t, err)
+				require.True(t, coinbase)
+				require.False(t, scanned)
+			default:
+				require.Error(t, err)
+				require.Nil(t, out)
+				if name == "spent" {
+					require.True(t, errors.Is(err, ErrOutputSpent))
+				}
+			}
+		})
+	}
+}
