+// The wallet knows confirmations of its published splice even when Neutrino
+// cannot answer gettxout. Conflicted values must not wrap to a huge uint32.
+type spliceConfirmationWallet struct {
+	lnwallet.WalletController
+	detail *lnwallet.TransactionDetail
+	err    error
+}
+
+func (w *spliceConfirmationWallet) GetTransactionDetails(*chainhash.Hash) (*lnwallet.TransactionDetail, error) {
+	return w.detail, w.err
+}
+func TestWalletSpliceConfirmations(t *testing.T) {
+	for _, n := range []int32{0, 1, 7, 21, -1} {
+		w := &spliceConfirmationWallet{detail: &lnwallet.TransactionDetail{NumConfirmations: n}}
+		expected := uint32(0)
+		if n > 0 {
+			expected = uint32(n)
+		}
+		require.Equal(t, expected, walletSpliceConfirmations(w, chainhash.Hash{}))
+	}
+	require.Zero(t, walletSpliceConfirmations(&spliceConfirmationWallet{err: errors.New("transaction unavailable")}, chainhash.Hash{}))
+	require.Zero(t, walletSpliceConfirmations(&spliceConfirmationWallet{}, chainhash.Hash{}))
+}
