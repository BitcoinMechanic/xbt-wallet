+func walletSpliceConfirmations(wallet lnwallet.WalletController, txid chainhash.Hash) uint32 {
+	tx, err := wallet.GetTransactionDetails(&txid)
+	if err != nil {
+		rpcsLog.Warnf("Unable to read splice transaction %v confirmations from wallet: %v", txid, err)
+		return 0
+	}
+	if tx == nil || tx.NumConfirmations < 0 {
+		return 0
+	}
+	return uint32(tx.NumConfirmations)
+}
