+// notifiedSpliceConfirmations uses verified inclusion and the current chain
+// height, never the wallet's potentially unconfirmed transaction-store entry.
+func notifiedSpliceConfirmations(event *chainntnfs.ConfirmationEvent, timeout <-chan time.Time,
+	bestHeight func() (int32, error)) uint32 {
+	select {
+	case conf, ok := <-event.Confirmed:
+		if !ok || conf == nil {
+			return 0
+		}
+		height, err := bestHeight()
+		if err != nil || height < 0 || uint32(height) < conf.BlockHeight {
+			return 0
+		}
+		select {
+		case <-event.NegativeConf:
+			return 0
+		default:
+		}
+		return uint32(height) - conf.BlockHeight + 1
+	case <-event.NegativeConf:
+		return 0
+	case <-timeout:
+		return 0
+	}
+}
