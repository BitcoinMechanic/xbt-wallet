+package btcwallet
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/btcsuite/btcd/blockchain"
+	"github.com/btcsuite/btcd/btcutil"
+	"github.com/btcsuite/btcd/btcutil/gcs"
+	"github.com/btcsuite/btcd/btcutil/gcs/builder"
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/btcsuite/btcwallet/chain"
+	"github.com/lightninglabs/neutrino"
+)
+
+// GetUtxoDetailsWithScript verifies peer splice inputs on Neutrino without
+// trusting a peer-supplied value or an external explorer. Search backwards for
+// the creating transaction, then scan forwards from that block for spends.
+// A missing, spent, reorged or incompletely checked output always fails closed.
+func (b *BtcWallet) GetUtxoDetailsWithScript(op *wire.OutPoint, script []byte,
+	cancel <-chan struct{}) (*wire.TxOut, uint32, bool, error) {
+	backend, ok := b.chain.(*chain.NeutrinoClient)
+	if !ok {
+		return b.GetUtxoDetails(op)
+	}
+	return verifyNeutrinoSpliceOutput(op, script, cancel, backend.CS, b.GetBestBlock, b.GetUtxo)
+}
+
+type spliceFilterChain interface {
+	GetBlockHash(int64) (*chainhash.Hash, error)
+	GetCFilter(chainhash.Hash, wire.FilterType, ...neutrino.QueryOption) (*gcs.Filter, error)
+	GetBlock(chainhash.Hash, ...neutrino.QueryOption) (*btcutil.Block, error)
+}
+
+func verifyNeutrinoSpliceOutput(op *wire.OutPoint, script []byte, cancel <-chan struct{}, cs spliceFilterChain,
+	best func() (*chainhash.Hash, int32, error),
+	unspentOutput func(*wire.OutPoint, []byte, uint32, <-chan struct{}) (*wire.TxOut, error)) (*wire.TxOut, uint32, bool, error) {
+	tip, height, err := best()
+	if err != nil {
+		return nil, 0, false, err
+	}
+	query := []neutrino.QueryOption{neutrino.Timeout(2 * time.Second), neutrino.NumRetries(1)}
+	for h := height; h > 0; h-- {
+		select {
+		case <-cancel:
+			return nil, 0, false, errors.New("splice input verification cancelled")
+		default:
+		}
+		hash, err := cs.GetBlockHash(int64(h))
+		if err != nil {
+			return nil, 0, false, err
+		}
+		filter, err := cs.GetCFilter(*hash, wire.GCSFilterRegular,
+			append(query, neutrino.OptimisticReverseBatch(), neutrino.MaxBatchSize(500))...)
+		if err != nil {
+			return nil, 0, false, err
+		}
+		if filter == nil {
+			return nil, 0, false, errors.New("missing compact filter")
+		}
+		match, err := filter.Match(builder.DeriveKey(hash), script)
+		if err != nil {
+			return nil, 0, false, err
+		}
+		if !match {
+			continue
+		}
+		block, err := cs.GetBlock(*hash, query...)
+		if err != nil {
+			return nil, 0, false, err
+		}
+		for _, tx := range block.Transactions() {
+			if tx.Hash().IsEqual(&op.Hash) {
+				if int(op.Index) >= len(tx.MsgTx().TxOut) {
+					return nil, 0, false, ErrOutputNotFound
+				}
+				out := tx.MsgTx().TxOut[op.Index]
+				if !bytes.Equal(script, out.PkScript) {
+					return nil, 0, false, errors.New("peer input script does not match confirmed transaction")
+				}
+				if blockchain.IsCoinBaseTx(tx.MsgTx()) {
+					return out, uint32(height - h + 1), true, nil
+				}
+				unspent, err := unspentOutput(op, script, uint32(h), cancel)
+				if err != nil {
+					return nil, 0, false, fmt.Errorf("peer input spend scan: %w", err)
+				}
+				if unspent == nil || unspent.Value != out.Value || !bytes.Equal(unspent.PkScript, out.PkScript) {
+					return nil, 0, false, errors.New("unspent output does not match confirmed transaction")
+				}
+				endTip, _, err := best()
+				if err != nil {
+					return nil, 0, false, err
+				}
+				if !endTip.IsEqual(tip) {
+					return nil, 0, false, errors.New("chain tip changed during splice input verification; retry after checking channel state")
+				}
+				return out, uint32(height - h + 1), false, nil
+			}
+		}
+	}
+	return nil, 0, false, ErrOutputNotFound
+}
