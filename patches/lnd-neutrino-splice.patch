+// Script-aware validation must receive the actual peer script and cancel work
+// on timeout rather than leave an unbounded background scan running.
+type scriptedSpliceWallet struct {
+	lnwallet.WalletController
+	wait      bool
+	cancelled chan struct{}
+	script    []byte
+}
+
+func (w *scriptedSpliceWallet) GetUtxoDetailsWithScript(_ *wire.OutPoint, script []byte, cancel <-chan struct{}) (*wire.TxOut, uint32, bool, error) {
+	w.script = append([]byte(nil), script...)
+	if w.wait {
+		<-cancel
+		close(w.cancelled)
+		return nil, 0, false, errors.New("cancelled")
+	}
+	return &wire.TxOut{Value: 42, PkScript: script}, 2, false, nil
+}
+func TestSpliceScriptAwareBackend(t *testing.T) {
+	old := confirmedOutputTimeout
+	confirmedOutputTimeout = 20 * time.Millisecond
+	t.Cleanup(func() { confirmedOutputTimeout = old })
+	w := &scriptedSpliceWallet{}
+	c := &spliceChain{wallet: w}
+	out, confs, _, err := c.ConfirmedOutputWithScript(wire.OutPoint{}, []byte{0, 20})
+	require.NoError(t, err)
+	require.EqualValues(t, 42, out.Value)
+	require.EqualValues(t, 2, confs)
+	require.Equal(t, []byte{0, 20}, w.script)
+	w = &scriptedSpliceWallet{wait: true, cancelled: make(chan struct{})}
+	c.wallet = w
+	_, _, _, err = c.ConfirmedOutputWithScript(wire.OutPoint{}, []byte{0, 20})
+	require.ErrorContains(t, err, "no input accepted")
+	select {
+	case <-w.cancelled:
+	case <-time.After(time.Second):
+		t.Fatal("verification not cancelled")
+	}
+}
